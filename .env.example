# Required for model scans. Setting only this key enables the model.
MUSE_API_KEY=
# Optional: blank = on when MUSE_API_KEY is present; set false to disable.
MODEL_ENABLED=
# Optional: in-memory per-process request cap; defaults to 200 when blank.
MODEL_MAX_REQUESTS=200
# Optional overrides.
MUSE_MODEL=
MUSE_API_URL=
# Optional: same-origin requests are accepted automatically.
ALLOWED_ORIGINS=
